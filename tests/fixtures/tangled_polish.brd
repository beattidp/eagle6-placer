<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE eagle SYSTEM "eagle.dtd">
<eagle version="6.6.0">
<drawing>
<settings>
<setting alwaysvectorfont="no"/>
<setting verticaltext="up"/>
</settings>
<grid distance="0.5" unitdist="mm" unit="mm" style="lines" multiple="1" display="yes" altdistance="0.1" altunitdist="mm" altunit="mm"/>
<layers>
<layer number="1" name="Top" color="4" fill="1" visible="yes" active="yes"/>
<layer number="16" name="Bottom" color="1" fill="1" visible="yes" active="yes"/>
<layer number="17" name="Pads" color="2" fill="1" visible="yes" active="yes"/>
<layer number="18" name="Vias" color="2" fill="1" visible="yes" active="yes"/>
<layer number="19" name="Unrouted" color="6" fill="1" visible="yes" active="yes"/>
<layer number="20" name="Dimension" color="15" fill="1" visible="yes" active="yes"/>
<layer number="21" name="tPlace" color="7" fill="1" visible="yes" active="yes"/>
<layer number="22" name="bPlace" color="7" fill="1" visible="yes" active="yes"/>
<layer number="23" name="tOrigins" color="15" fill="1" visible="yes" active="yes"/>
<layer number="24" name="bOrigins" color="15" fill="1" visible="yes" active="yes"/>
<layer number="25" name="tNames" color="7" fill="1" visible="yes" active="yes"/>
<layer number="26" name="bNames" color="7" fill="1" visible="yes" active="yes"/>
<layer number="27" name="tValues" color="7" fill="1" visible="yes" active="yes"/>
<layer number="28" name="bValues" color="7" fill="1" visible="yes" active="yes"/>
<layer number="39" name="tKeepout" color="4" fill="11" visible="yes" active="yes"/>
<layer number="40" name="bKeepout" color="1" fill="11" visible="yes" active="yes"/>
<layer number="41" name="tRestrict" color="4" fill="10" visible="yes" active="yes"/>
<layer number="42" name="bRestrict" color="1" fill="10" visible="yes" active="yes"/>
<layer number="45" name="Holes" color="7" fill="1" visible="yes" active="yes"/>
</layers>
<board>
<plain>
<wire x1="0" y1="0" x2="50" y2="0" width="0" layer="20"/>
<wire x1="50" y1="0" x2="50" y2="40" width="0" layer="20"/>
<wire x1="50" y1="40" x2="0" y2="40" width="0" layer="20"/>
<wire x1="0" y1="40" x2="0" y2="0" width="0" layer="20"/>
</plain>
<libraries>
<library name="synthetic">
<packages>
<package name="HDR-1X4">
<pad name="1" x="0" y="3.81" drill="1.0" diameter="1.778"/>
<pad name="2" x="0" y="1.27" drill="1.0" diameter="1.778"/>
<pad name="3" x="0" y="-1.27" drill="1.0" diameter="1.778"/>
<pad name="4" x="0" y="-3.81" drill="1.0" diameter="1.778"/>
<wire x1="-1.27" y1="5.08" x2="1.27" y2="5.08" width="0.15" layer="21"/>
<wire x1="1.27" y1="5.08" x2="1.27" y2="-5.08" width="0.15" layer="21"/>
<wire x1="1.27" y1="-5.08" x2="-1.27" y2="-5.08" width="0.15" layer="21"/>
<wire x1="-1.27" y1="-5.08" x2="-1.27" y2="5.08" width="0.15" layer="21"/>
<text x="-1.27" y="5.5" size="1.0" layer="25">&gt;NAME</text>
</package>
<package name="SOIC-8">
<smd name="1" x="-2.7" y="1.905" dx="1.5" dy="0.6" layer="1"/>
<smd name="2" x="-2.7" y="0.635" dx="1.5" dy="0.6" layer="1"/>
<smd name="3" x="-2.7" y="-0.635" dx="1.5" dy="0.6" layer="1"/>
<smd name="4" x="-2.7" y="-1.905" dx="1.5" dy="0.6" layer="1"/>
<smd name="5" x="2.7" y="-1.905" dx="1.5" dy="0.6" layer="1"/>
<smd name="6" x="2.7" y="-0.635" dx="1.5" dy="0.6" layer="1"/>
<smd name="7" x="2.7" y="0.635" dx="1.5" dy="0.6" layer="1"/>
<smd name="8" x="2.7" y="1.905" dx="1.5" dy="0.6" layer="1"/>
<wire x1="-1.95" y1="2.45" x2="1.95" y2="2.45" width="0.15" layer="21"/>
<wire x1="1.95" y1="2.45" x2="1.95" y2="-2.45" width="0.15" layer="21"/>
<wire x1="1.95" y1="-2.45" x2="-1.95" y2="-2.45" width="0.15" layer="21"/>
<wire x1="-1.95" y1="-2.45" x2="-1.95" y2="2.45" width="0.15" layer="21"/>
<text x="-2.0" y="3.0" size="1.0" layer="25">&gt;NAME</text>
</package>
<package name="R0805">
<smd name="1" x="-0.95" y="0" dx="1.0" dy="1.3" layer="1"/>
<smd name="2" x="0.95" y="0" dx="1.0" dy="1.3" layer="1"/>
<wire x1="-1.0" y1="0.65" x2="1.0" y2="0.65" width="0.127" layer="21"/>
<wire x1="1.0" y1="0.65" x2="1.0" y2="-0.65" width="0.127" layer="21"/>
<wire x1="1.0" y1="-0.65" x2="-1.0" y2="-0.65" width="0.127" layer="21"/>
<wire x1="-1.0" y1="-0.65" x2="-1.0" y2="0.65" width="0.127" layer="21"/>
<text x="-1.0" y="1.0" size="0.8" layer="25">&gt;NAME</text>
</package>
</packages>
</library>
</libraries>
<attributes>
</attributes>
<variantdefs>
</variantdefs>
<classes>
<class number="0" name="default" width="0" drill="0">
</class>
</classes>
<designrules name="default">
<param name="layerSetup" value="(1*16)"/>
<param name="mdWireWire" value="8mil"/>
<param name="mdWirePad" value="8mil"/>
<param name="mdWireVia" value="8mil"/>
<param name="mdPadPad" value="8mil"/>
<param name="mdPadVia" value="8mil"/>
<param name="mdViaVia" value="8mil"/>
<param name="mdCopperDimension" value="40mil"/>
<param name="msWidth" value="10mil"/>
<param name="msDrill" value="24mil"/>
</designrules>
<autorouter>
<pass name="Default">
<param name="RoutingGrid" value="50mil"/>
</pass>
</autorouter>
<elements>
<element name="J1" library="synthetic" package="HDR-1X4" value="IN_HDR" x="5" y="20" locked="yes"/>
<element name="J2" library="synthetic" package="HDR-1X4" value="OUT_HDR" x="45" y="20" locked="yes"/>
<element name="U1" library="synthetic" package="SOIC-8" value="OPAMP" x="25" y="20" locked="yes"/>
<!-- Deliberately tangled / swapped / backwards unlocked passives -->
<element name="R1" library="synthetic" package="R0805" value="10k" x="15" y="10" rot="R180"/>
<element name="R2" library="synthetic" package="R0805" value="10k" x="15" y="30" rot="R180"/>
<element name="R3" library="synthetic" package="R0805" value="10k" x="35" y="10" rot="R180"/>
<element name="R4" library="synthetic" package="R0805" value="10k" x="35" y="30" rot="R180"/>
<element name="C1" library="synthetic" package="R0805" value="100nF" x="12" y="34" rot="R90"/>
<element name="C2" library="synthetic" package="R0805" value="100nF" x="38" y="6" rot="R90"/>
</elements>
<signals>
<signal name="IN_A">
<contactref element="J1" pad="1"/>
<contactref element="R1" pad="1"/>
</signal>
<signal name="U1_IN_A">
<contactref element="R1" pad="2"/>
<contactref element="U1" pad="1"/>
</signal>
<signal name="IN_B">
<contactref element="J1" pad="2"/>
<contactref element="R2" pad="1"/>
</signal>
<signal name="U1_IN_B">
<contactref element="R2" pad="2"/>
<contactref element="U1" pad="2"/>
</signal>
<signal name="U1_OUT_A">
<contactref element="U1" pad="8"/>
<contactref element="R3" pad="1"/>
</signal>
<signal name="OUT_A">
<contactref element="R3" pad="2"/>
<contactref element="J2" pad="1"/>
</signal>
<signal name="U1_OUT_B">
<contactref element="U1" pad="7"/>
<contactref element="R4" pad="1"/>
</signal>
<signal name="OUT_B">
<contactref element="R4" pad="2"/>
<contactref element="J2" pad="2"/>
</signal>
<signal name="FILTER_L">
<contactref element="U1" pad="3"/>
<contactref element="C1" pad="1"/>
</signal>
<signal name="FILTER_R">
<contactref element="U1" pad="6"/>
<contactref element="C2" pad="1"/>
</signal>
<signal name="GND">
<contactref element="J1" pad="4"/>
<contactref element="J2" pad="4"/>
<contactref element="U1" pad="4"/>
<contactref element="C1" pad="2"/>
<contactref element="C2" pad="2"/>
</signal>
<signal name="VCC">
<contactref element="J1" pad="3"/>
<contactref element="J2" pad="3"/>
<contactref element="U1" pad="5"/>
</signal>
</signals>
</board>
</drawing>
</eagle>
