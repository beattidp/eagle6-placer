<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE eagle SYSTEM "eagle.dtd">
<eagle version="6.6.0">
<drawing>
<settings>
<setting alwaysvectorfont="no"/>
<setting verticaltext="up"/>
</settings>
<grid distance="0.5" unitdist="mm" unit="mm" style="lines" multiple="1" display="yes" altdistance="0.1" altunitdist="mm" altunit="mm"/>
<layers>
<layer number="1" name="Top" color="4" fill="1" visible="yes" active="yes"/>
<layer number="16" name="Bottom" color="1" fill="1" visible="yes" active="yes"/>
<layer number="17" name="Pads" color="2" fill="1" visible="yes" active="yes"/>
<layer number="18" name="Vias" color="2" fill="1" visible="yes" active="yes"/>
<layer number="19" name="Unrouted" color="6" fill="1" visible="yes" active="yes"/>
<layer number="20" name="Dimension" color="15" fill="1" visible="yes" active="yes"/>
<layer number="21" name="tPlace" color="7" fill="1" visible="yes" active="yes"/>
<layer number="22" name="bPlace" color="7" fill="1" visible="yes" active="yes"/>
<layer number="23" name="tOrigins" color="15" fill="1" visible="yes" active="yes"/>
<layer number="24" name="bOrigins" color="15" fill="1" visible="yes" active="yes"/>
<layer number="25" name="tNames" color="7" fill="1" visible="yes" active="yes"/>
<layer number="26" name="bNames" color="7" fill="1" visible="yes" active="yes"/>
<layer number="39" name="tKeepout" color="4" fill="11" visible="yes" active="yes"/>
<layer number="40" name="bKeepout" color="1" fill="11" visible="yes" active="yes"/>
<layer number="41" name="tRestrict" color="4" fill="10" visible="yes" active="yes"/>
<layer number="42" name="bRestrict" color="1" fill="10" visible="yes" active="yes"/>
<layer number="45" name="Holes" color="7" fill="1" visible="yes" active="yes"/>
</layers>
<board>
<plain>
<wire x1="0" y1="0" x2="60" y2="0" width="0" layer="20"/>
<wire x1="60" y1="0" x2="60" y2="45" width="0" layer="20"/>
<wire x1="60" y1="45" x2="0" y2="45" width="0" layer="20"/>
<wire x1="0" y1="45" x2="0" y2="0" width="0" layer="20"/>
<hole x="4" y="4" drill="3.2"/>
<hole x="56" y="41" drill="3.2"/>
<rectangle x1="24" y1="28" x2="36" y2="38" layer="39"/>
</plain>
<libraries>
<library name="synthetic">
<packages>
<package name="HDR-1X3">
<pad name="1" x="0" y="2.54" drill="1.0" diameter="1.778"/>
<pad name="2" x="0" y="0" drill="1.0" diameter="1.778"/>
<pad name="3" x="0" y="-2.54" drill="1.0" diameter="1.778"/>
<wire x1="-1.27" y1="3.81" x2="1.27" y2="3.81" width="0.15" layer="21"/>
<wire x1="1.27" y1="3.81" x2="1.27" y2="-3.81" width="0.15" layer="21"/>
<wire x1="1.27" y1="-3.81" x2="-1.27" y2="-3.81" width="0.15" layer="21"/>
<wire x1="-1.27" y1="-3.81" x2="-1.27" y2="3.81" width="0.15" layer="21"/>
</package>
<package name="R0805">
<smd name="1" x="-0.95" y="0" dx="1.0" dy="1.3" layer="1"/>
<smd name="2" x="0.95" y="0" dx="1.0" dy="1.3" layer="1"/>
<wire x1="-1.0" y1="0.65" x2="1.0" y2="0.65" width="0.127" layer="21"/>
<wire x1="1.0" y1="0.65" x2="1.0" y2="-0.65" width="0.127" layer="21"/>
<wire x1="1.0" y1="-0.65" x2="-1.0" y2="-0.65" width="0.127" layer="21"/>
<wire x1="-1.0" y1="-0.65" x2="-1.0" y2="0.65" width="0.127" layer="21"/>
</package>
<package name="AXIAL-THT">
<pad name="1" x="-3.81" y="0" drill="0.8" diameter="1.6"/>
<pad name="2" x="3.81" y="0" drill="0.8" diameter="1.6"/>
<wire x1="-2.54" y1="1.27" x2="2.54" y2="1.27" width="0.15" layer="21"/>
<wire x1="2.54" y1="1.27" x2="2.54" y2="-1.27" width="0.15" layer="21"/>
<wire x1="2.54" y1="-1.27" x2="-2.54" y2="-1.27" width="0.15" layer="21"/>
<wire x1="-2.54" y1="-1.27" x2="-2.54" y2="1.27" width="0.15" layer="21"/>
</package>
</packages>
</library>
</libraries>
<attributes>
</attributes>
<variantdefs>
</variantdefs>
<classes>
<class number="0" name="default" width="0" drill="0">
</class>
</classes>
<designrules name="default">
<param name="layerSetup" value="(1*16)"/>
<param name="mdWireWire" value="8mil"/>
<param name="mdWirePad" value="8mil"/>
<param name="mdWireVia" value="8mil"/>
<param name="mdPadPad" value="8mil"/>
<param name="mdPadVia" value="8mil"/>
<param name="mdViaVia" value="8mil"/>
<param name="mdCopperDimension" value="40mil"/>
<param name="msWidth" value="10mil"/>
<param name="msDrill" value="24mil"/>
</designrules>
<autorouter>
<pass name="Default">
<param name="RoutingGrid" value="50mil"/>
</pass>
</autorouter>
<elements>
<element name="J1" library="synthetic" package="HDR-1X3" value="PWR_IN" x="6" y="22" locked="yes"/>
<element name="J2" library="synthetic" package="HDR-1X3" value="SIG_OUT" x="54" y="22" locked="yes"/>
<!-- Top-side unlocked SMDs -->
<element name="C1" library="synthetic" package="R0805" value="1uF" x="42" y="10" rot="R180"/>
<element name="C2" library="synthetic" package="R0805" value="100nF" x="16" y="34" rot="R90"/>
<!-- Bottom-side unlocked SMDs (must stay on bottom in keep-side mode) -->
<element name="R1" library="synthetic" package="R0805" value="4.7k" x="45" y="34" rot="MR0"/>
<element name="R2" library="synthetic" package="R0805" value="4.7k" x="15" y="10" rot="MR90"/>
<!-- Unlocked THT component (blocks both top and bottom sides) -->
<element name="L1" library="synthetic" package="AXIAL-THT" value="10uH" x="30" y="14" rot="R180"/>
</elements>
<signals>
<signal name="SIG1">
<contactref element="J1" pad="1"/>
<contactref element="L1" pad="1"/>
<contactref element="C1" pad="1"/>
</signal>
<signal name="SIG2">
<contactref element="L1" pad="2"/>
<contactref element="R1" pad="1"/>
<contactref element="C2" pad="1"/>
</signal>
<signal name="SIG3">
<contactref element="R1" pad="2"/>
<contactref element="R2" pad="1"/>
<contactref element="J2" pad="1"/>
</signal>
<signal name="SIG4">
<contactref element="R2" pad="2"/>
<contactref element="J2" pad="2"/>
</signal>
<signal name="GND">
<contactref element="J1" pad="3"/>
<contactref element="J2" pad="3"/>
<contactref element="C1" pad="2"/>
<contactref element="C2" pad="2"/>
<polygon width="0.254" layer="16">
<vertex x="2" y="2"/>
<vertex x="58" y="2"/>
<vertex x="58" y="43"/>
<vertex x="2" y="43"/>
</polygon>
</signal>
</signals>
</board>
</drawing>
</eagle>
